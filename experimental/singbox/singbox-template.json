{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "节点选择"
      },
      {
        "type": "udp",
        "tag": "dns-direct",
        "server": "223.5.5.5",
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      },
      {
        "server": "dns-remote"
      }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "selector",
      "tag": "节点选择",
      "outbounds": [
        "手动选择",
        "独立选择",
        "自动选择"
      ],
      "default": "手动选择"
    },
    {
      "type": "selector",
      "tag": "手动选择",
      "outbounds": [
        "direct"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "独立选择",
      "outbounds": [
        "direct"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "AI分流",
      "outbounds": [
        "节点选择",
        "自动选择"
      ],
      "default": "节点选择"
    },
    {
      "type": "selector",
      "tag": "YouTube分流",
      "outbounds": [
        "节点选择",
        "自动选择"
      ],
      "default": "节点选择"
    },
    {
      "type": "selector",
      "tag": "Telegram分流",
      "outbounds": [
        "节点选择",
        "自动选择"
      ],
      "default": "节点选择"
    },
    {
      "type": "selector",
      "tag": "Google",
      "outbounds": [
        "节点选择",
        "自动选择"
      ],
      "default": "节点选择"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "direct"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "600s",
      "tolerance": 100
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-remote",
    "rule_set": [
      {
        "tag": "reject",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Advertising/Advertising_Classical.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "direct",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/ChinaMax/ChinaMax_Classical.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "proxy",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Global/Global_Classical.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "openai",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/OpenAI/OpenAI.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "anthropic",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Anthropic/Anthropic.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "youtube",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/YouTube/YouTube.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "telegram",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Telegram/Telegram.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "google",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Google/Google.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "my_whitelist",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/Spittingjiu/clash-custom-rules/main/my_whitelist.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "private",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Lan/Lan.yaml",
        "update_interval": "1d"
      },
      {
        "tag": "cncidr",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/cncidr.txt",
        "update_interval": "1d"
      },
      {
        "tag": "lancidr",
        "type": "remote",
        "format": "source",
        "url": "https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/lancidr.txt",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
        "update_interval": "1d"
      }
    ],
    "rules": [
      {
        "action": "route",
        "rule_set": [
          "my_whitelist"
        ],
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": [
          "reject"
        ],
        "outbound": "block"
      },
      {
        "action": "route",
        "rule_set": [
          "private"
        ],
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": [
          "lancidr"
        ],
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": [
          "openai"
        ],
        "outbound": "AI分流"
      },
      {
        "action": "route",
        "rule_set": [
          "anthropic"
        ],
        "outbound": "AI分流"
      },
      {
        "action": "route",
        "rule_set": [
          "youtube"
        ],
        "outbound": "YouTube分流"
      },
      {
        "action": "route",
        "rule_set": [
          "telegram"
        ],
        "outbound": "Telegram分流"
      },
      {
        "action": "route",
        "rule_set": [
          "google"
        ],
        "outbound": "Google"
      },
      {
        "action": "route",
        "rule_set": [
          "proxy"
        ],
        "outbound": "节点选择"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "outbound": "节点选择"
      },
      {
        "action": "route",
        "rule_set": [
          "direct"
        ],
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": [
          "cncidr"
        ],
        "outbound": "direct"
      },
      {
        "action": "route",
        "outbound": "节点选择"
      }
    ],
    "final": "节点选择"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    }
  }
}
